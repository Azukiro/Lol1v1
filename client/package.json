{
  "name": "lol1v1",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:ui": "ng build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/write-config.js",
    "build": "npm run build:ui && npm run build:electron",
    "dev": "npm run build:electron && concurrently -k -n ui,app \"ng serve --port 4200\" \"wait-on http://localhost:4200 && electron .\"",
    "test": "tsc -p tsconfig.electron.json && node --test dist-electron/src/shared/shared.test.js",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "private": true,
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@microsoft/signalr": "^10.0.11",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "wait-on": "^9.5.1"
  },
  "productName": "LoL 1v1",
  "description": "Séries de 1v1 League of Legends entre amis, arbitrées automatiquement.",
  "author": "Lucas",
  "main": "dist-electron/electron/main.js"
}